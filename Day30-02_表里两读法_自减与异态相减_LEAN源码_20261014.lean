import Mathlib

/-! ================================================================
   偏元数学 · Day30 · 表里两读法 · 相减的两读法（自减与异态）
   ------------------------------------------------------------------
   核心：对象层 = ℂ × ℝ；⊖：(x,φ) ⊖ (y,ψ) = (x − y + ε, φ − ψ)。
       命题 B （自减）  ：(x,φ) ⊖ (x,φ) = (ε, 0)。
       命题 B′（异态相减）：(x,φ) ⊖ (x,ψ) = (ε, φ − ψ)  —— 同值、异向。
       并给出解耦的两条：值分量只含 ε、向分量只含相位差。
   本稿范围：证 B 与 B′；证值分量与相位无关、向分量为相位差。
   不做：不替 ε 取值；不证退化、零与单位元、结合（见 Day30-03）。
   注：上承 Day30-01（对象层模型与表里同态，同仓）；
       B′ 是 S-001「方向偏好二态」在对象层上的复活：同值异向时，差只剩方向。
   日期：2026-10-14
   纪律：逐字提交 —— 抬头是提交原文的一部分，改动即改 SHA256。
   ================================================================ -/

namespace PrenaryS009

-- ① 偏元残差（显式参数；本稿不替 ε 取值）
variable (ε : ℂ)

-- ② 对象层：ℂ × ℝ 上的偏元减法（值作差、向作差）
def subP (p q : ℂ × ℝ) : ℂ × ℝ := (p.1 - q.1 + ε, p.2 - q.2)

-- 定理1（命题 B·自减）：同对象相减，得 (ε, 0)
theorem subP_self (x : ℂ) (φ : ℝ) : subP ε (x, φ) (x, φ) = (ε, 0) := by
  ext <;> simp [subP]

-- 定理2（命题 B′·异态相减）：同值异向相减，得 (ε, φ − ψ)
theorem subP_diff_phase (x : ℂ) (φ ψ : ℝ) : subP ε (x, φ) (x, ψ) = (ε, φ - ψ) := by
  ext <;> simp [subP]

-- 定理3（自减 · 向分量为零）
theorem subP_self_snd (x : ℂ) (φ : ℝ) : (subP ε (x, φ) (x, φ)).2 = 0 := by
  simp [subP]

-- 定理4（异态 · 向分量即相位差）
theorem subP_diff_snd (x : ℂ) (φ ψ : ℝ) : (subP ε (x, φ) (x, ψ)).2 = φ - ψ := by
  simp [subP]

-- 定理5（异态 · 值分量恒为 ε，与相位无关）
theorem subP_diff_fst (x : ℂ) (φ ψ : ℝ) : (subP ε (x, φ) (x, ψ)).1 = ε := by
  simp [subP]

-- 定理6（解耦 · 值分量不随相位变）：任取两组相位，值分量相同
theorem subP_diff_fst_eq (x : ℂ) (φ ψ φ' ψ' : ℝ) :
    (subP ε (x, φ) (x, ψ)).1 = (subP ε (x, φ') (x, ψ')).1 := by
  simp [subP]

end PrenaryS009
