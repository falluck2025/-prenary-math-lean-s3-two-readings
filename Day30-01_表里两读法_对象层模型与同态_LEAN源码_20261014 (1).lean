import Mathlib

/-! ================================================================
   偏元数学 · Day30 · 表里两读法 · 对象层模型与表里同态
   ------------------------------------------------------------------
   核心：两层——动作层 = ℂ（带 ⊖_C：a ⊖ b = a − b + ε）；
              对象层 = ℂ × ℝ（带 ⊖：(x,φ) ⊖ (y,ψ) = (x − y + ε, φ − ψ)）；
       对角嵌入 D : ℂ → ℂ × ℝ，D x = (x, 0)；
       命题 A（表里同态）：D (x ⊖_C y) = (D x) ⊖ (D y)。
   本稿范围：定义两层模型；证命题 A；证相位平移下的标架不变性（⊖ 不变）与 D 的标架依赖。
   不做：不替 ε 取值；不证退化、零与单位元、结合（见 Day30-03）；不商 2π（相位用 ℝ 承载，只保和差）。
   注：上承 Day29 prenary-math-lean-s3-boundary-ascent。
       本稿取 φ₀ := 0（规范选择）——所有命题只依赖相位差，标的平移不改变结论。
   日期：2026-10-14
   纪律：逐字提交 —— 抬头是提交原文的一部分，改动即改 SHA256。
   ================================================================ -/

namespace PrenaryS009

-- ① 偏元残差（显式参数；本稿不替 ε 取值）
variable (ε : ℂ)

-- ② 动作层：ℂ 上的偏元减法（同对象相减留 ε）
def subC (a b : ℂ) : ℂ := a - b + ε

-- ③ 对象层：ℂ × ℝ 上的偏元减法（值与向各自作差）
def subP (p q : ℂ × ℝ) : ℂ × ℝ := (p.1 - q.1 + ε, p.2 - q.2)

-- ④ 对角嵌入 D（动作层 → 对象层，向取 0）
def D (x : ℂ) : ℂ × ℝ := (x, 0)

-- ⑤ 相位平移（换标架）：同时给两层加同一个 c
def shift (c : ℝ) (p : ℂ × ℝ) : ℂ × ℝ := (p.1, p.2 + c)

-- 定理1（命题 A·表里同态）：D (x ⊖_C y) = (D x) ⊖ (D y)
theorem D_hom (x y : ℂ) : D (subC ε x y) = subP ε (D x) (D y) := by
  ext <;> simp [subC, subP, D]

-- 定理2：D 的像落在 ℂ × {0} 上（定义即得）
theorem D_snd (x : ℂ) : (D x).2 = 0 := rfl

-- 定理3（标架不变性）：⊖ 在两层同时平移下不变
theorem subP_shift_invariant (c : ℝ) (p q : ℂ × ℝ) :
    subP ε (shift c p) (shift c q) = subP ε p q := by
  ext <;> simp [subP, shift]

-- 定理4（D 的标架依赖）：平移后的 D 像为 (x, c)，故 D 依赖所选标架
theorem D_shift (c : ℝ) (x : ℂ) : shift c (D x) = (x, c) := by
  simp [shift, D]

end PrenaryS009
